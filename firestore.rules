rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function currentUid() {
      return request.auth.uid;
    }
    function isSelf(id) {
      return signedIn() && currentUid() == id;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }
    function isSystemWallet(id) {
      return id == 'prorank_escrow' || id == 'prorank_system';
    }

    // ==================== FIGHTERS ====================
    match /fighters/{uid} {
      allow read: if true;
      allow create: if isAdmin() || isSelf(uid);
      allow update: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin();
      match /{sub=**} {
        allow read: if true;
        allow write: if isAdmin() || isSelf(uid);
      }
    }

    // ==================== USERS ====================
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin();
      match /{sub=**} {
        allow read: if true;
        allow write: if isAdmin() || isSelf(uid);
      }
    }

    // ==================== WALLET ====================
    match /wallet_balances/{balanceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        || isSelf(balanceId)
        || (isSystemWallet(balanceId) && signedIn());
      allow delete: if isAdmin();
    }

    match /wallet_transactions/{txId} {
      allow read: if true;
      allow create: if isAdmin() || signedIn();
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ==================== TOURNAMENTS ====================
    match /tournaments/{tid} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdmin()
        || signedIn();
      allow delete: if isAdmin() || signedIn();
    }

    match /tournaments/{tid}/matches/{mid} {
      allow read: if true;
      allow create: if isAdmin() || signedIn();
      allow update: if isAdmin() || signedIn() || true;
      allow delete: if isAdmin() || signedIn();
    }

    match /tournaments/{tid}/judgeSessions/{token} {
      allow read, write: if true;
    }

    // ==================== REGISTRATIONS ====================
    match /tournament_registrations/{regId} {
      allow read: if true;
      allow create: if isAdmin() || signedIn();
      allow update: if isAdmin() || signedIn();
      allow delete: if isAdmin() || signedIn();
    }

    // ==================== FIGHTS ====================
    match /fights/{fightId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ==================== ORGS ====================
    match /organizations/{id} {
      allow read: if true;
      allow create, update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }
    match /organization_requests/{id} {
      allow read, write: if signedIn() || isAdmin() || true;
    }

    // ==================== SEASONS ====================
    match /seasons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /season_rewards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== ACHIEVEMENTS ====================
    match /achievements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /userAchievements/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==================== SOCIAL ====================
    match /likes/{id} {
      allow read: if true;
      allow create, delete: if signedIn() || isAdmin();
      allow update: if isAdmin();
    }
    match /chats/{id} {
      allow read, write: if signedIn() || isAdmin() || true;
      match /{sub=**} {
        allow read, write: if signedIn() || isAdmin() || true;
      }
    }
    match /challenges/{id} {
      allow read, write: if signedIn() || true;
    }
    match /sparring_offers/{id} {
      allow read, write: if signedIn() || true;
    }
    match /notifications/{id} {
      allow read, write: if signedIn() || true;
    }

    // ==================== TEMPLATES ====================
    match /tournament_templates/{id} {
      allow read, write: if signedIn() || true;
    }

    // ==================== CLUBS ====================
    match /clubs/{id} {
      allow read: if true;
      allow create, update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }
    match /club_messages/{id} {
      allow read, write: if signedIn() || true;
    }
    match /club_messages_reactions/{id} {
      allow read, write: if signedIn() || true;
    }
    match /club_requests/{id} {
      allow read, write: if signedIn() || true;
    }
    match /club_applications/{id} {
      allow read, write: if signedIn() || true;
    }

    // ==================== MARKETPLACE ====================
    match /partners/{id} {
      allow read: if true;
      allow create, update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }
    match /partner_requests/{id} {
      allow read, write: if signedIn() || true;
    }
    match /products/{id} {
      allow read: if true;
      allow create, update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow create, update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }
    match /favoriteProducts/{id} {
      allow read, write: if signedIn() || true;
    }
    match /orders/{id} {
      allow read, write: if signedIn() || true;
    }
    match /physical_orders/{id} {
      allow read, write: if signedIn() || true;
    }
    match /digital_products/{id} {
      allow read: if true;
      allow write: if signedIn() || isAdmin();
    }
    match /digital_orders/{id} {
      allow read, write: if signedIn() || true;
    }
    match /marketplace_orders/{id} {
      allow read, write: if signedIn() || true;
    }

    // ==================== HALLS ====================
    match /halls/{id} {
      allow read: if true;
      allow create, update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==================== FALLBACK ====================
    match /{document=**} {
      allow read, write: if true;
    }
  }
}